Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
        - /MarkerArray1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 20
      Color: 160; 160; 160
      Line Style:
        Value: Lines
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.08
      Frame Timeout: 15
    - Class: rviz_default_plugins/MarkerArray
      Name: MarkerArray
      Enabled: true
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fluoro_markers
  Global Options:
    Background Color: 30; 30; 36
    Fixed Frame: anatomy
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.6
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.35
      Yaw: 0.8
      Target Frame: anatomy
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
